{
    "builds": [
        {
            "src": "app/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/app/main.py"
        }
    ],
    "functions": {
        "api/main.py": {
            "runtime": "python3.10"
        }
    }
}